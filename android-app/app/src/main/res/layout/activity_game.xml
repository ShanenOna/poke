<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GameActivity">

    <!-- Background Image -->
    <ImageView
        android:id="@+id/game_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/game_map" />

    <!-- Pokémon markers -->
    <ImageView android:id="@+id/pokemon_1" android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/pikachu" app:layout_constraintLeft_toLeftOf="parent" app:layout_constraintTop_toTopOf="parent" android:layout_marginStart="100dp" android:layout_marginTop="100dp" />
    <ImageView android:id="@+id/pokemon_2" android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/charmander" app:layout_constraintRight_toRightOf="parent" app:layout_constraintTop_toTopOf="parent" android:layout_marginEnd="80dp" android:layout_marginTop="250dp" />
    <ImageView android:id="@+id/pokemon_3" android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/squirtle" app:layout_constraintLeft_toLeftOf="parent" app:layout_constraintBottom_toBottomOf="parent" android:layout_marginStart="50dp" android:layout_marginBottom="250dp" />
    <ImageView android:id="@+id/pokemon_4" android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/bulbasaur" app:layout_constraintRight_toRightOf="parent" app:layout_constraintBottom_toBottomOf="parent" android:layout_marginEnd="120dp" android:layout_marginBottom="300dp" />

    <!-- Character -->
    <ImageView
        android:id="@+id/character"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/my_character"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- GameBoy Style D-Pad Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- D-Pad Background (The cross shape) -->
        <View
            android:id="@+id/dpad_cross_v"
            android:layout_width="45dp"
            android:layout_height="130dp"
            android:background="#222222"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/dpad_cross_h"
            android:layout_width="130dp"
            android:layout_height="45dp"
            android:background="#222222"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Actual Buttons -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_up"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/dpad_button_bg"
            android:text="▲"
            android:textColor="#444444"
            app:layout_constraintTop_toTopOf="@id/dpad_cross_v"
            app:layout_constraintStart_toStartOf="@id/dpad_cross_v"
            app:layout_constraintEnd_toEndOf="@id/dpad_cross_v" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_down"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/dpad_button_bg"
            android:text="▼"
            android:textColor="#444444"
            app:layout_constraintBottom_toBottomOf="@id/dpad_cross_v"
            app:layout_constraintStart_toStartOf="@id/dpad_cross_v"
            app:layout_constraintEnd_toEndOf="@id/dpad_cross_v" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_left"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/dpad_button_bg"
            android:text="◀"
            android:textColor="#444444"
            app:layout_constraintStart_toStartOf="@id/dpad_cross_h"
            app:layout_constraintTop_toTopOf="@id/dpad_cross_h"
            app:layout_constraintBottom_toBottomOf="@id/dpad_cross_h" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_right"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/dpad_button_bg"
            android:text="▶"
            android:textColor="#444444"
            app:layout_constraintEnd_toEndOf="@id/dpad_cross_h"
            app:layout_constraintTop_toTopOf="@id/dpad_cross_h"
            app:layout_constraintBottom_toBottomOf="@id/dpad_cross_h" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>